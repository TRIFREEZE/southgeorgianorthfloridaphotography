# ─────────────────────────────────────────────────────────────────────────────
# Red Clay & Light: environment variables
# Copy to .env.local for local development. In production, add these in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# Never commit real values. Only NEXT_PUBLIC_* values are exposed to browsers.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Your canonical domain, no trailing slash. Used for canonical URLs, sitemap,
# Open Graph and structured data. (Falls back to the Vercel URL if unset.)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Supabase (required in production) ────────────────────────────────────────
# Supabase → Project Settings → API (or API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public anon / publishable key. Safe to expose; RLS limits it to published photos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (sb_secret_…) or legacy service_role key. NEVER expose.
SUPABASE_SECRET_KEY=
# (Alternatively: SUPABASE_SERVICE_ROLE_KEY=  and/or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=)

# ── Email via Resend (strongly recommended) ──────────────────────────────────
# Without these, inquiries are still saved and visible in /admin, but nobody is emailed.
RESEND_API_KEY=
# Must use a domain you've verified in Resend.
EMAIL_FROM="Red Clay & Light <hello@your-domain.com>"
# Where new-inquiry notifications go.
OWNER_NOTIFICATION_EMAIL=you@your-domain.com

# ── Owner admin (/admin) ─────────────────────────────────────────────────────
# Comma-separated emails allowed to sign in. Create the same user(s) in
# Supabase → Authentication → Users (email + password).
ADMIN_EMAILS=you@your-domain.com
# Random string, 32+ characters. Generate: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# ── Security ─────────────────────────────────────────────────────────────────
# Random string used to hash visitor IPs for rate limiting. openssl rand -hex 32
IP_HASH_SALT=
# Protects the daily cleanup cron (/api/cron/prune). openssl rand -hex 32
CRON_SECRET=

# Optional extra bot protection: Cloudflare Turnstile (free).
# If you set one, set both. Leave empty to rely on honeypot + rate limiting.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Public business details (shown on the site; leave blank to hide) ────────
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# General area only, e.g. "Thomasville, GA". Never a home address.
NEXT_PUBLIC_BASE_CITY=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ── Search Console (optional) ────────────────────────────────────────────────
# The content value of Google's HTML-tag verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Dashboard (optional) ─────────────────────────────────────────────────────
# Your Supabase plan's storage allowance, for the usage bar in /admin (Pro = 100).
STORAGE_QUOTA_GB=100

# ── Local testing only (ignored on Vercel, never set these in Vercel) ────────
# Lets `next start` accept inquiries into memory without Supabase (E2E tests).
# ALLOW_MEMORY_STORE=1
# Lets a local production build run the CMS on files in ./.data instead of Supabase.
# (`npm run dev` does this automatically when Supabase isn't configured.)
# ALLOW_LOCAL_BACKEND=1
# CMS_LOCAL_DIR=.data
# Local-only admin password, used ONLY when Supabase isn't configured and never on
# Vercel. Pick anything for your machine; production logins go through Supabase Auth.
# ADMIN_DEV_PASSWORD=
